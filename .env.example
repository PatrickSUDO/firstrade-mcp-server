# Copy this file to .env and fill in your own Firstrade credentials.
# Never commit the real .env — it is already covered by .gitignore.

FT_USERNAME=your_firstrade_username
FT_PASSWORD=your_firstrade_password
FT_PIN=your_trade_pin
FT_EMAIL=your_email_used_for_otp

# Optional: TOTP seed from your authenticator app, enables headless
# session re-auth (server.py self-heals on 401 without a human typing a code).
# Leave blank to fall back to manual `tools/ft_setup.py step1` / `step2 <code>`.
# This is the full authenticator seed, not a 6-digit code — anyone who has it
# can mint valid login codes for your account indefinitely without your phone.
FT_TOTP_SECRET=

# Kill switch for place_stock_order / place_option_order / place_option_spread.
# Leave unset (or anything other than true/1/yes) and those tools refuse to send
# real orders, even with a valid confirm_token. preview_* tools always work.
FT_ALLOW_LIVE_ORDERS=

# Required if your login has more than one Firstrade account — order/quote/cancel
# tools refuse to pick one for you (no silent account_numbers[0] default) once
# there's ambiguity. Leave blank for a single-account login.
FT_ACCOUNT_NUMBER=
